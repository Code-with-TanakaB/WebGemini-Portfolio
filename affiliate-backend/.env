# WebGemini Affiliate System Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret Key (Change this in production!)
JWT_SECRET=webgemini-affiliate-secret-key-2024-change-in-production

# Database Configuration
# SQLite database will be created automatically at: ./affiliate-backend/affiliate.db

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5500,http://127.0.0.1:5500

# Google reCAPTCHA (Get keys from: https://www.google.com/recaptcha/admin)
# Site Key: Add to frontend HTML data-sitekey attribute
# Secret Key: Add here for backend verification
RECAPTCHA_SECRET_KEY=6Lf7BgksAAAAAHeAZwODWQOzCgzfpu0bGdAAO--Q

# Commission Rates
STARTER_COMMISSION_RATE=0.10
HIGH_TIER_COMMISSION_RATE=0.25
